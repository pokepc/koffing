{
  "name": "koffing-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @koffing/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter koffing test",
    "typecheck": "pnpm -r typecheck",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "^0.70.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.5.1"
}
